# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=   # service_role key (secret) — backend only, never use anon key here

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Public: accessible in browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
ENVIRONMENT=development
# Production only — set to your Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app
