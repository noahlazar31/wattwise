NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
ENVIRONMENT=development
# Production only — set to your Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app
